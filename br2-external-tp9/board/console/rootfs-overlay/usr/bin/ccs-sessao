#!/bin/sh
# ccs-sessao - o que roda dentro do X do console: o gerenciador de janelas
# (ccs-wm, que poe os jogos em tela cheia) e o menu. Com argumento, abre so
# aquele script de jogo (usado pelo ccs-jogar quando o menu esta fechado).
ccs-wm &
if [ -n "$1" ]; then
	exec /bin/sh "$1"
fi
exec /usr/bin/ccs-menu
